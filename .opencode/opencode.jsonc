{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["STYLE_GUIDE.md"],
  "provider": {
    "zai-glm": {
      "api": "https://api.z.ai/api/coding/paas/v4/chat/completions",
      "env": ["ZAI_API_KEY"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4"
      },
      "models": {
        "glm-4.6": {
          "id": "glm-4.6",
          "name": "GLM 4.6 Coder",
          "capabilities": {
            "temperature": true,
            "reasoning": true,
            "attachment": false,
            "toolcall": true
          },
          "cost": { "input": 0.0025, "output": 0.01 },
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    },
    "nanogpt": {
      "api": "https://nano-gpt.com/api/v1/chat/completions",
      "env": ["NANO_GPT_API_KEY"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://nano-gpt.com/api/v1"
      },
      "models": {
        "minimax-m2": {
          "id": "MiniMax-M2",
          "name": "MiniMax M2",
          "capabilities": {
            "temperature": true,
            "reasoning": false,
            "attachment": false,
            "toolcall": false
          },
          "cost": { "input": 0.001, "output": 0.01 },
          "limit": { "context": 32768, "output": 2048 }
        }
      }
    },
    "google-gemma": {
      "api": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "env": ["GOOGLE_AI_API_KEY"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "AIzaSyByZp4CqmNu-YH9uFTGBMljgxeRZvnPdAE"
      },
      "models": {
        "gemma-3-27b-it": {
          "id": "gemini-2.0-flash-exp",
          "name": "Gemini 2.0 Flash Exp",
          "capabilities": {
            "temperature": true,
            "reasoning": true,
            "attachment": true,
            "toolcall": true
          },
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 1000000, "output": 8192 }
        }
      }
    }
  },
  "model": "zai-glm/glm-4.6",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "write": "allow"
  }
}
