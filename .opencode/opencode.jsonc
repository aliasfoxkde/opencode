{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["STYLE_GUIDE.md"],
  "provider": {
    "zai-glm": {
      "api": "https://api.z.ai/api/coding/paas/v4/chat/completions",
      "env": ["ZAI_API_KEY"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4"
      },
      "models": {
        "glm-4.7": {
          "id": "glm-4.7",
          "name": "GLM 4.7",
          "capabilities": {
            "temperature": true,
            "reasoning": true,
            "attachment": false,
            "toolcall": true
          },
          "cost": { "input": 0.0025, "output": 0.01 },
          "limit": { "context": 200000, "output": 8192 }
        }
      }
    },
    "nanogpt": {
      "api": "https://nano-gpt.com/api/v1/chat/completions",
      "env": ["NANO_GPT_API_KEY"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://nano-gpt.com/api/v1"
      },
      "models": {
        "minimax-m2": {
          "id": "MiniMax-M2",
          "name": "MiniMax M2",
          "capabilities": {
            "temperature": true,
            "reasoning": false,
            "attachment": false,
            "toolcall": false
          },
          "cost": { "input": 0.001, "output": 0.01 },
          "limit": { "context": 32768, "output": 2048 }
        }
      }
    }
  },
  "model": "opencode/big-pickle",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "write": "allow"
  }
}
