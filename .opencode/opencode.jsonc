{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["STYLE_GUIDE.md"],
  "provider": {
    "zai-glm47": {
      "api": "https://api.z.ai/api/anthropic",
      "env": ["ZAI_API_KEYS"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.z.ai/api/anthropic",
        "headers": {
          "anthropic-dangerous-direct-browser-access": "false"
        }
      },
      "models": {
        "glm-4.7": {
          "id": "glm-4.7",
          "name": "GLM 4.7",
          "capabilities": {
            "temperature": true,
            "reasoning": true,
            "attachment": false,
            "toolcall": true,
            "input": { "text": true, "audio": false, "image": false, "video": false, "pdf": false },
            "output": { "text": true, "audio": false, "image": false, "video": false, "pdf": false }
          },
          "cost": { "input": 0.0025, "output": 0.01 },
          "limit": { "context": 200000, "output": 8192 }
        }
      }
    },
    "zai-glm46v": {
      "api": "https://api.z.ai/api/anthropic",
      "env": ["ZAI_API_KEYS"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.z.ai/api/anthropic"
      },
      "models": {
        "glm-4.6v": {
          "id": "glm-4.6v",
          "name": "GLM 4.6V Vision",
          "capabilities": {
            "temperature": true,
            "reasoning": true,
            "attachment": true,
            "toolcall": true,
            "input": { "text": true, "audio": false, "image": true, "video": false, "pdf": false },
            "output": { "text": true, "audio": false, "image": false, "video": false, "pdf": false }
          },
          "cost": { "input": 0.002, "output": 0.008 },
          "limit": { "context": 128000, "output": 4096 }
        }
      }
    },
    "nanogpt-qwen": {
      "api": "https://nano-gpt.com/v1/images/generations",
      "env": ["NANO_GPT_API_KEY"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://nano-gpt.com/v1"
      },
      "models": {
        "qwen-vl-plus": {
          "id": "qwen-vl-plus",
          "name": "Qwen VL Plus",
          "capabilities": {
            "temperature": true,
            "reasoning": false,
            "attachment": true,
            "toolcall": false,
            "input": { "text": true, "audio": false, "image": true, "video": false, "pdf": false },
            "output": { "text": true, "audio": false, "image": true, "video": false, "pdf": false }
          },
          "cost": { "input": 0.001, "output": 0.01 },
          "limit": { "context": 32768, "output": 2048 }
        }
      }
    },
    "google-gemma": {
      "api": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "env": ["GOOGLE_AI_API_KEY"],
      "npm": "@ai-sdk/google",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai"
      },
      "models": {
        "gemma-3-27b-it": {
          "id": "models/gemma-3-27b-it",
          "name": "Gemma 3 27B IT",
          "capabilities": {
            "temperature": true,
            "reasoning": true,
            "attachment": true,
            "toolcall": true,
            "input": { "text": true, "audio": false, "image": true, "video": false, "pdf": false },
            "output": { "text": true, "audio": false, "image": false, "video": false, "pdf": false }
          },
          "cost": { "input": 0.0, "output": 0.0 },
          "limit": { "context": 131072, "output": 8192 }
        },
        "gemini-2.0-flash-exp": {
          "id": "models/gemini-2.0-flash-exp",
          "name": "Gemini 2.0 Flash Experimental",
          "capabilities": {
            "temperature": true,
            "reasoning": true,
            "attachment": true,
            "toolcall": true,
            "input": { "text": true, "audio": false, "image": true, "video": false, "pdf": false },
            "output": { "text": true, "audio": false, "image": false, "video": false, "pdf": false }
          },
          "cost": { "input": 0.0, "output": 0.0 },
          "limit": { "context": 1000000, "output": 8192 }
        }
      }
    },
    "opencode": {
      "options": {}
    }
  },
  "model": "zai-glm47/glm-4.7",
  "small_model": "google-gemma/gemma-3-27b-it",
  "vision_model": "zai-glm46v/glm-4.6v",
  "image_model": "nanogpt-qwen/qwen-vl-plus",
  "safety": {
    "enabled": true,
    "configPath": "/home/mkinney/repos/Droid-Config/config/safety",
    "strictMode": false,
    "warnMode": true,
    "ragIntegration": true,
    "ragDatabasePath": "/home/mkinney/repos/Droid-Config/data/memory.db"
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "write": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
